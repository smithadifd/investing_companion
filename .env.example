# ===========================================
# Investing Companion - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Database
# ===========================================
POSTGRES_USER=investing
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=investing_companion

# ===========================================
# Application
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# Encryption key for secrets-at-rest (Schwab/Claude/Discord credentials stored
# per-user). SEPARATE from SECRET_KEY so rotating the JWT signing key does not
# brick stored tokens. Generate a durable value with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to fall back to the legacy SECRET_KEY-derived key during the
# transition (a warning is logged). New ciphertext is written under this key
# (version v2) only when it is set; existing v1/legacy ciphertext stays
# decryptable either way.
ENCRYPTION_KEY=

# development, staging, production
ENVIRONMENT=development

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Reverse proxies whose X-Forwarded-For header we trust for client-IP identity
# (rate limiting). Comma-separated IPs or CIDRs. Empty = trust no proxy (XFF is
# ignored, direct peer used) so clients can't spoof their rate-limit key. Set to
# your Caddy/ingress address(es) when deployed behind a reverse proxy.
TRUSTED_PROXIES=

# ===========================================
# External API Keys
# ===========================================
# Alpha Vantage (free tier available)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Massive (formerly Polygon.io — rebranded 2025-10-30; same API, same keys, and
# the variable keeps the POLYGON_ name so existing configs stay valid).
# Optional and key-gated: when empty the provider is never built.
# Get key at: https://massive.com/ (legacy: https://polygon.io/)
#
# Powers history, fundamentals and symbol search. It ALSO serves quotes, but the
# Starter plan is 15-minute delayed, so it is ranked below every live quote
# source and anything it serves is flagged as delayed in the UI.
POLYGON_API_KEY=

# Which Massive products the key above actually holds, comma-separated:
#   quote,history,fundamentals,search
# Massive sells these separately (a plan can include stock aggregates but not
# Stocks Financials) and the API can't be asked, so declare it here — this is
# the one place to read and the one place to change it.
#
# A surface left off the list routes to the next provider (Yahoo) exactly as a
# provider failure would, instead of coming back empty and looking like a thin
# ticker. Unset or blank = every surface (the key's reality is then discovered
# from 403s at runtime); to disable Massive entirely, clear POLYGON_API_KEY.
# A 403 on a surface listed here logs loudly and corrects itself until restart.
#
# MASSIVE_ENTITLEMENTS=quote,history,fundamentals,search

# Finnhub (news data - free tier, 60 req/min)
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# Schwab (optional, real-time + pre/post-market quotes via OAuth)
# Register an app at: https://developer.schwab.com/
# SCHWAB_CALLBACK_URL must exactly match the callback registered with Schwab,
# e.g. https://your-host/api/v1/schwab/callback (Schwab requires HTTPS, or
# https://127.0.0.1 for local development). FRONTEND_URL is where the OAuth
# callback sends the browser afterwards. Without these, quotes use the free
# Yahoo Finance base - Schwab is never required.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=
FRONTEND_URL=http://localhost:3000

# ===========================================
# Notifications
# ===========================================
# Discord webhook URL for alerts
# Create at: Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# ===========================================
# AI Integration
# ===========================================
# Note: Claude API key is stored per-user in the database
# This is a fallback/default key for development
CLAUDE_API_KEY=
# Default Claude model for in-app analysis (configurable; must be a current id).
# One of: claude-sonnet-5 (default), claude-opus-4-8, claude-haiku-4-5-20251001
AI_DEFAULT_MODEL=claude-sonnet-5
# Redis response-cache TTL for AI analyses, seconds (0 disables the cache)
AI_RESPONSE_CACHE_TTL=3600
# Per-user, per-day token ceiling for in-app AI; fails closed at the ceiling
# (0 disables the budget)
AI_DAILY_TOKEN_BUDGET=1000000

# ===========================================
# Advisor context pack outbox (optional)
# ===========================================
# Publish the context pack to a directory a host-side rclone job syncs to a
# private Google Drive folder the claude.ai "IC Advisor" Project reads. Leave
# CONTEXT_PACK_OUTBOX_DIR empty to disable the feature; set it to /app/outbox
# (the bind mount in docker-compose) to enable publishing.
CONTEXT_PACK_OUTBOX_DIR=
# Host path that backs /app/outbox (what the rclone job pushes to Drive).
CONTEXT_PACK_OUTBOX_HOST_DIR=./data/claude-outbox
CONTEXT_PACK_HISTORY_RETENTION_DAYS=30
# Optional: source dir for the advisor contract docs (handoff-schema.md,
# advisor-actions.md) copied into <outbox>/reference/ on publish.
CONTEXT_PACK_REFERENCE_DIR=

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Frontend
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
