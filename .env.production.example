# =============================================================================
# Investing Companion - Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and update all values before deployment
#
# IMPORTANT: Never commit .env.production to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SETTINGS (must be changed from defaults)
# -----------------------------------------------------------------------------

# Domain name for your deployment (e.g., invest.example.com)
DOMAIN=invest.yourdomain.com

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=your-email@example.com

# Secret key for JWT tokens - MUST be changed!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_generate_a_secure_32_char_minimum_key

# Dedicated key for secrets-at-rest (Schwab/Claude tokens in user_settings),
# kept SEPARATE from SECRET_KEY so rotating the JWT key can't brick stored
# tokens. Empty = fall back to the legacy SECRET_KEY-derived key (v1). Once set,
# NEW ciphertext is written under it (v2) and the value must never change.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database credentials - MUST be changed from defaults!
POSTGRES_USER=investing_prod
POSTGRES_PASSWORD=CHANGE_ME_generate_secure_password
POSTGRES_DB=investing_companion

# -----------------------------------------------------------------------------
# OPTIONAL SETTINGS (can keep defaults or customize)
# -----------------------------------------------------------------------------

# Registration settings
# Set to false to disable new user registration (single-user mode)
REGISTRATION_ENABLED=false

# Discord webhook for alerts (optional - alerts still work, just no Discord)
DISCORD_WEBHOOK_URL=

# Claude API key for AI features (optional - users can add their own in settings)
CLAUDE_API_KEY=

# Advisor context pack outbox (optional). Set CONTEXT_PACK_OUTBOX_DIR=/app/outbox
# to enable publishing the context pack; a host-side rclone job then syncs
# CONTEXT_PACK_OUTBOX_HOST_DIR to a private Google Drive folder. Empty = disabled.
CONTEXT_PACK_OUTBOX_DIR=
CONTEXT_PACK_OUTBOX_HOST_DIR=./data/claude-outbox
CONTEXT_PACK_HISTORY_RETENTION_DAYS=30
CONTEXT_PACK_REFERENCE_DIR=

# Alpha Vantage API key for additional market data (optional)
# Free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Massive (formerly Polygon.io) API key (optional, paid service). Setting it
# makes Massive the PRIMARY source on every surface — quote / history /
# fundamentals / search — with the free chain (Yahoo -> Stooq -> Alpha Vantage)
# as the fallback behind it. Starter-plan quotes are 15-minute delayed and are
# labelled as such in the UI. Blank = the free chain, unchanged.
POLYGON_API_KEY=

# Which Massive products that key holds, comma-separated (quote, history,
# fundamentals, search). Massive sells them separately and the API can't be
# asked, so it is declared here. A surface left off routes to the next provider
# exactly as a failure would, rather than returning an empty result. Unset or
# blank = all four (reality is then discovered from 403s, which log loudly).
# MASSIVE_ENTITLEMENTS=quote,history,fundamentals,search

# -----------------------------------------------------------------------------
# ADVANCED SETTINGS (usually don't need to change)
# -----------------------------------------------------------------------------

# Environment identifier
ENVIRONMENT=production

# Reverse proxies whose X-Forwarded-For header is trusted for rate-limit
# identity (comma-separated IPs/CIDRs). Empty = trust none: the direct peer is
# used, so a client can't spoof its rate-limit key. Set to your Caddy/ingress
# address when deployed behind a proxy.
# TRUSTED_PROXIES=

# CORS origins (should match your domain with HTTPS)
# CORS_ORIGINS=https://invest.yourdomain.com

# JWT token lifetimes
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Cache TTLs (in seconds)
# QUOTE_CACHE_TTL=900
# FUNDAMENTALS_CACHE_TTL=86400
# HISTORY_CACHE_TTL=3600


# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying, verify:
#
# [ ] DOMAIN is set to your actual domain
# [ ] ACME_EMAIL is your real email for Let's Encrypt
# [ ] SECRET_KEY is a unique, secure 32+ character string
# [ ] POSTGRES_PASSWORD is secure (16+ characters, mixed case, numbers, symbols)
# [ ] DNS is configured to point your domain to your Synology
# [ ] Ports 80 and 443 are forwarded to your Synology (for Let's Encrypt)
# [ ] .env.production is NOT committed to git
#
# To deploy:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# =============================================================================
